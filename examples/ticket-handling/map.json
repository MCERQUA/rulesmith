{
  "nodes": {
    "team": {
      "type": "call",
      "question": {
        "type": "choice",
        "instructions": "Which team should answer this ticket?",
        "criteria": {
          "billing": "Charges, invoices, refunds.",
          "technical": "Errors, outages, anything broken."
        }
      },
      "inputs": {
        "observation": {
          "type": "state"
        }
      }
    },
    "billing": {
      "type": "graph",
      "path": "units/billing.rules",
      "when": {
        "type": "compare",
        "node": "team",
        "op": "eq",
        "value": "billing"
      }
    },
    "escalate": {
      "type": "value",
      "value": "engineer"
    },
    "decision": {
      "type": "coalesce",
      "sources": [
        "billing",
        "escalate"
      ]
    }
  },
  "outputs": {
    "label": {
      "type": "node",
      "node": "decision"
    }
  }
}
