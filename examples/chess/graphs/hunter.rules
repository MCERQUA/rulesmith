read capture.best_gain in [-9, 9]
read check.gain in [-9, 9]
read check.available in [0, 1]
read hanging.worst in [0, 9]
read king.can_castle in [0, 1]
read king.in_check in [0, 1]
read material.balance in [-39, 39]
when king.in_check >= 1: SAVE
when capture.best_gain >= 3: CAPTURE
when check.available >= 1 and material.balance >= 3: CHECK
when capture.best_gain >= 1: CAPTURE
when hanging.worst >= 3: SAVE
when king.can_castle >= 1: CASTLE
always: DEVELOP
