    "threat": {
      "type": "call",
      "question": {
        "type": "choice",
        "instructions": "Decide whether to fight. Live monsters have category Monster and no Dead in their name.",
        "criteria": {
          "fight": "A live monster is on screen.",
          "clear": "No live monster is on screen."
        }
      },
      "inputs": {
        "observation": {
          "type": "state"
        }
      }
    },
    "aim": {
      "type": "call",
      "question": {
        "type": "choice",
        "instructions": "Aim at the nearest live on-screen monster, then fire. TURN_LEFT moves on-screen objects right; TURN_RIGHT moves them left.",
        "criteria": {
          "ATTACK": "The nearest live monster's box covers the screen center: its x is between -0.25 and 0.25, or closer to 0 than half its width.",
          "TURN_LEFT": "The nearest live monster is left of that: x below -0.25 and not covering the center.",
          "TURN_RIGHT": "The nearest live monster is right of that: x above 0.25 and not covering the center."
        }
      },
      "inputs": {
        "observation": {
          "type": "state"
        }
      },
      "when": {
        "type": "compare",
        "node": "threat",
        "op": "eq",
        "value": "fight"
      }
    },
    "door": {
      "type": "call",
      "question": {
        "type": "noul",
        "instructions": "The blocked view straight ahead is a door or switch that could be opened with USE, not a plain wall. Consider whether USE was among the recent actions without effect."
      },
      "inputs": {
        "observation": {
          "type": "state"
        }
      },
      "when": {
        "type": "all",
        "conditions": [
          {
            "type": "compare",
            "node": "threat",
            "op": "eq",
            "value": "clear"
          },
          {
            "type": "compare",
            "node": "ahead",
            "op": "lt",
            "value": 96
          }
        ]
      }
    },
    "open_door": {
      "type": "value",
      "value": "MOVE_FORWARD+USE",
      "when": {
        "type": "compare",
        "node": "door",
        "op": "ge",
        "value": 0.5
      }
    },
