{
  "description": "Win a one-on-one deathmatch against another player: frag them more often than they frag you. Opponents are objects in category Player; the target is the nearest one on screen. The label is your next action.",
  "scenario": "cig",
  "map": "MAP03",
  "deathmatch": true,
  "labels": ["MOVE_FORWARD", "MOVE_FORWARD+TURN_LEFT", "MOVE_FORWARD+TURN_RIGHT", "TURN_LEFT", "TURN_RIGHT", "MOVE_BACKWARD", "ATTACK", "USE", "MOVE_FORWARD+USE"],
  "reward_range": [-60, 60],
  "episode_timeout": 2100,
  "variables": ["HEALTH", "ARMOR", "SELECTED_WEAPON_AMMO"],
  "observe": ["memory", "target"],
  "rewards": {"frag_reward": 1, "death_penalty": 1, "damage_made_reward": 0.01, "damage_taken_penalty": 0.01},
  "train": [1, 2, 3, 4],
  "validation": [5, 6],
  "test": [7, 8, 9, 10, 11, 12]
}
